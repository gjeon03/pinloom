{
  "name": "pinloom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local Claude Code workspace. Persistent history, pinned answers, project Wiki, Teams orchestration, GitHub-backed backup.",
  "license": "MIT",
  "scripts": {
    "build:shared": "pnpm --filter @pinloom/shared build",
    "build:mcp-server": "pnpm --filter @pinloom/mcp-server build",
    "build": "pnpm build:shared && pnpm build:mcp-server && pnpm -r --filter @pinloom/backend build && pnpm -r --filter @pinloom/frontend build",
    "predev": "pnpm build:shared && pnpm build:mcp-server",
    "predev:backend": "pnpm build:shared && pnpm build:mcp-server",
    "predev:frontend": "pnpm build:shared",
    "dev": "concurrently --kill-others \"pnpm --filter @pinloom/backend dev\" \"pnpm --filter @pinloom/frontend dev\"",
    "dev:backend": "pnpm --filter @pinloom/backend dev",
    "dev:frontend": "pnpm --filter @pinloom/frontend dev",
    "prestart": "pnpm build",
    "start": "concurrently --kill-others --names backend,frontend \"pnpm --filter @pinloom/backend start\" \"pnpm --filter @pinloom/frontend preview\"",
    "test": "pnpm --filter @pinloom/backend test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "postinstall": "pnpm build:shared && pnpm build:mcp-server"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  }
}
