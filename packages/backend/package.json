{
  "name": "@pinloom/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@pinloom/mcp-server": "workspace:*",
    "@pinloom/shared": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.2",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.19.3",
    "vitest": "^4.1.5"
  }
}
