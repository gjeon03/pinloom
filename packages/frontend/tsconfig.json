{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Tests run via vitest (esbuild) + use node builtins; excluded from the app
  // typecheck so node globals don't pollute the DOM-typed app build.
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../shared" }
  ]
}
